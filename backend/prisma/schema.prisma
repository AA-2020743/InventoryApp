generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Single owner account. Kept as a real table (instead of hardcoded
// credentials) so a password change / future second device doesn't
// require a code change.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// Single settings row (singleton, like User) - always read/written via the
// fixed id "singleton" rather than looking one up, since there's only ever
// one. Currently just the starting capital the owner invested, used to
// tell whether the business's current net worth has fallen below it.
model BusinessSettings {
  id            String   @id
  startingValue Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt     DateTime @updatedAt
}

model Product {
  id                String   @id @default(uuid())
  // Nullable: fallback products (no printed barcode, e.g. loose produce)
  // are identified by name + photo instead.
  barcode           String?  @unique
  name              String
  imageUrl          String?
  category          String?
  unit              String   @default("pcs") // pcs, kg, g, l, ml ...
  // How many base units are in one package (pallet/carton/box/etc.) of
  // this product; 1 means sold as individual units. Lets the client offer
  // "how many packages" data entry instead of a raw unit count.
  // quantity/lowStockThreshold below remain the source of truth in base
  // units regardless - this is purely for converting on entry.
  unitsPerPackage   Decimal  @default(1) @db.Decimal(12, 3)
  // When true, unit is locked to "kg" and purchaseCost/sellingPrice are
  // interpreted as price-per-kg; the Sell screen prompts for grams instead
  // of a whole-unit count and converts grams/1000 into the quantity below.
  soldByWeight      Boolean  @default(false)
  purchaseCost      Decimal  @db.Decimal(12, 2) // latest known cost from supplier
  sellingPrice      Decimal  @db.Decimal(12, 2)
  quantity          Decimal  @default(0) @db.Decimal(12, 3)
  lowStockThreshold Decimal  @default(0) @db.Decimal(12, 3)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  saleItems               SaleItem[]
  inventoryTransactions   InventoryTransaction[]

  @@index([category])
}

enum InventoryTransactionType {
  RESTOCK
  SALE
  ADJUSTMENT
  SALE_CORRECTION
  SPOILAGE
}

// Audit trail of every stock movement, so current quantity is always
// reconstructable / explainable.
model InventoryTransaction {
  id             String                   @id @default(uuid())
  productId      String
  product        Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           InventoryTransactionType
  quantityChange Decimal                  @db.Decimal(12, 3) // positive = added, negative = removed
  unitCost       Decimal?                 @db.Decimal(12, 2) // cost at time of restock
  note           String?
  supplierInvoiceId String?
  supplierInvoice   SupplierInvoice?      @relation(fields: [supplierInvoiceId], references: [id])
  // RESTOCK only, and only when not linked to a supplierInvoice above (that
  // invoice's own PENDING/PAID lifecycle already governs the cash side) -
  // set when paying for this stock couldn't be fully covered by the cash
  // register. Same always-deduct mechanism as Expense/SupplierInvoice.
  deficitAmount  Decimal                  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime                 @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactInfo String?
  createdAt   DateTime @default(now())

  invoices SupplierInvoice[]
}

enum InvoiceStatus {
  PENDING
  PAID
}

model SupplierInvoice {
  id            String        @id @default(uuid())
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  invoiceNumber String?
  amount        Decimal       @db.Decimal(12, 2)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  status        InvoiceStatus @default(PENDING)
  paidAt        DateTime?
  // Set when marking this invoice paid couldn't fully cover it from the
  // cash register - mirrors Expense.deficitAmount, same always-deduct
  // mechanism (see applyCashDeduction).
  deficitAmount Decimal       @default(0) @db.Decimal(12, 2)
  notes         String?
  // A photo of the physical invoice/receipt, uploaded via the generic
  // /api/uploads/image endpoint (see uploads.routes.ts) - stores the
  // returned relative URL, same convention as Product.imageUrl.
  imageUrl      String?
  createdAt     DateTime      @default(now())

  inventoryTransactions InventoryTransaction[]

  @@index([status])
  @@index([dueDate])
}

enum SalePaymentStatus {
  PAID
  DEFERRED
}

model Sale {
  id          String     @id @default(uuid())
  // Set by the Android app's offline sales queue so a retried sync (after a
  // dropped response, not just a dropped request) can be recognized as the
  // same sale instead of double-selling; null for sales made while online.
  clientId    String?    @unique
  totalAmount Decimal    @db.Decimal(12, 2)
  totalCost   Decimal    @db.Decimal(12, 2) // snapshot COGS, for profit stats
  // DEFERRED = sold on credit/a tab - goods left, cash hasn't. Revenue is
  // still recognized immediately (totalAmount/totalCost already feed
  // today/month profit like any sale); the outstanding DEFERRED amount is
  // additionally counted as a receivable in the dashboard's net valuation
  // until collectSale marks it PAID.
  paymentStatus SalePaymentStatus @default(PAID)
  customerName  String?
  collectedAt   DateTime?
  createdAt   DateTime   @default(now())
  // Running total actually received so far on a DEFERRED sale via partial
  // repayments (see collect-partial in sales.routes.ts). Reaches
  // totalAmount exactly when the sale flips to PAID. Always 0 for a sale
  // that was PAID from the start.
  amountCollected Decimal @default(0) @db.Decimal(12, 2)

  items SaleItem[]

  @@index([createdAt])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2) // sellingPrice snapshot at sale time
  unitCost  Decimal @db.Decimal(12, 2) // purchaseCost snapshot at sale time
  subtotal  Decimal @db.Decimal(12, 2)

  @@index([productId])
}

// A one-off operating cost (rent, salaries, supplies, etc.), always paid
// out of the cash register immediately: if the register doesn't have
// enough cash on hand, only what's available is deducted and the shortfall
// is recorded as deficitAmount rather than ever letting the register go
// negative. See applyExpenseCashDeduction in expenses.routes.ts.
model Expense {
  id            String   @id @default(uuid())
  name          String
  amount        Decimal  @db.Decimal(12, 2)
  // The calendar day the expense happened - shown to the owner and counted
  // toward that day's/month's profit and expense totals.
  date          DateTime @default(now())
  deficitAmount Decimal  @default(0) @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now())
}

// A miscellaneous profit entry not tied to inventory or a checkout sale
// (e.g. a service fee, a one-off arrangement) - the mirror image of
// Expense, except there's no deficit concept since receiving money can't
// come up short: it always credits the cash register in full immediately.
model OtherSale {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(12, 2)
  category  String?
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

// Non-inventory business property (equipment, fixtures, etc.) that still
// counts toward "what is this business worth" - its value is summed into
// the dashboard's net valuation alongside inventory, separately from
// products since it isn't stock that gets sold.
model Asset {
  id        String   @id @default(uuid())
  name      String
  value     Decimal  @db.Decimal(12, 2)
  category  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DebtStatus {
  OUTSTANDING
  REPAID
}

// Cash lent by the business to a worker - the opposite direction of a
// deferred sale (money leaves the till immediately here, rather than
// arriving later), but tracked the same way: a receivable owed back,
// grouped/collected per-person on the Others -> Debt tab exactly like
// Deferred Sales groups by customer. Deliberately kept off revenue/profit
// entirely (it's neither a sale nor an expense) - it only ever affects the
// dashboard's net-worth composition (cash vs. receivable), and the total
// net valuation doesn't move: the full `amount` is booked as a receivable
// the moment the debt is created, while only what the till could actually
// cover leaves cashRegisterBalance (see applyCashDeduction) - any gap
// between the two is `deficitAmount`, folded into allTimeDeficitTotal so
// the receivable-vs-cash-vs-deficit math nets to zero either way.
model Debt {
  id           String     @id @default(uuid())
  workerName   String
  amount       Decimal    @db.Decimal(12, 2)
  // Running total repaid so far via partial repayments (see repayDebtAmount
  // in debts.routes.ts) - mirrors Sale.amountCollected. Reaches `amount`
  // exactly when status flips to REPAID.
  amountRepaid Decimal    @default(0) @db.Decimal(12, 2)
  status       DebtStatus @default(OUTSTANDING)
  // Set once at creation if the till couldn't fully cover disbursing this
  // debt - same always-deduct + deficit-on-shortfall mechanism as Expense/
  // SupplierInvoice/restock. Never touched by repayments afterward.
  deficitAmount Decimal   @default(0) @db.Decimal(12, 2)
  notes        String?
  repaidAt     DateTime?
  createdAt    DateTime   @default(now())

  @@index([createdAt])
}

// Signed ledger of physical cash movements (mirrors InventoryTransaction's
// audit-log pattern) - the register's current balance is always the sum
// of every entry, never stored/mutated directly, so it's reconstructable
// and auditable the same way stock levels are. Positive = cash in
// (including reconciling a manual count upward), negative = cash out
// (e.g. paying a supplier invoice from the till).
model CashRegisterEntry {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  invoiceId String?
  // Set for entries auto-created from a non-deferred sale (or a deferred
  // one once collected), so editing/deleting/collecting that sale later
  // can find and adjust or remove exactly this entry instead of guessing.
  saleId    String?
  // Set for the entry auto-created when an expense is paid out of the
  // register (fully or partially), mirroring saleId - lets editing/deleting
  // that expense find and adjust or remove exactly this entry.
  expenseId String?
  // Set for the entry auto-created when a RESTOCK is paid out of the
  // register (not linked to a supplier invoice), mirroring expenseId.
  inventoryTransactionId String?
  // Set for the entry auto-created when a miscellaneous profit entry
  // (OtherSale) is recorded, mirroring expenseId.
  otherSaleId String?
  // True only for entries created by a partial repayment on a DEFERRED
  // sale (see collectSaleAmount in sales.routes.ts). A sale can have many
  // of these over time, unlike the single sync entry create/edit maintain
  // via saleId - keeping them flagged lets that single-entry lookup
  // (findFirst by saleId) skip these instead of getting confused by which
  // one to treat as "the" entry.
  isPartialSaleCollection Boolean @default(false)
  // Set for the entry auto-created when a Debt is disbursed (negative,
  // via applyCashDeduction) or repaid (positive, via repayDebtAmount),
  // mirroring saleId/expenseId.
  debtId String?
  // True only for a debt-repayment entry (mirrors isPartialSaleCollection)
  // - a debt can have many of these over time (one per repayment), unlike
  // the single disbursement entry, so lookups for "the disbursement entry"
  // can skip these.
  isPartialDebtRepayment Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
