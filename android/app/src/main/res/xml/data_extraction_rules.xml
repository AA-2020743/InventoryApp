<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same exclusion as backup_rules.xml, for cloud
     backups and for moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/inventory_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/inventory_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
